# Copy this file to backend/.env for local development and fill in the values.
# Never commit the real .env file. On Cloud Run, set the same names as
# environment variables (secrets preferably via Secret Manager).

# ---------- Required ----------
MONGO_URL=mongodb://localhost:27017
DB_NAME=everbook_dev
# Long random value, different for dev and prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start if this is missing.
JWT_SECRET=

# ---------- URLs & CORS ----------
FRONTEND_URL=http://localhost:3000
# The PDF is made by a headless browser opening FRONTEND_URL/print/<album>.
# FRONTEND_URL must therefore be a stable address of the frontend for this
# environment (never a one-off Vercel deployment URL). If that address is
# protected by Vercel (Settings → Deployment Protection), also set the secret
# from "Protection Bypass for Automation" here, or the browser gets a Vercel
# login page instead of the album.
# VERCEL_PROTECTION_BYPASS_SECRET=
BACKEND_URL=http://localhost:8000
# Comma-separated list of websites allowed to call the API from a browser.
# FRONTEND_URL is always allowed automatically. "*" is ignored.
CORS_ORIGINS=http://localhost:3000
# Optional pattern for extra allowed URLs. Prefer listing exact URLs above:
# a loose pattern on *.vercel.app can match other people's Vercel sites.
# CORS_ORIGIN_REGEX=

# ---------- Rate limiting ----------
# Limits on login / forgot-password / contact. Keep "true" everywhere except
# automated test runs.
RATE_LIMIT_ENABLED=true

# ---------- Admin ----------
ADMIN_EMAIL=

# ---------- Storage (Cloudflare R2) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------- Email ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=
PRINTER_EMAIL=
DELIVERY_EMAIL=

# ---------- Sign-in with Google / Apple ----------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ---------- AI duplicate check (optional) ----------
# When set, ambiguous near-duplicate photos are compared by Gemini (see
# app/services/curation.py and section 6 of the privacy policy). Without it,
# curation stays 100% local (image hash + sharpness).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# ---------- Scheduled jobs ----------
CLEANUP_SECRET=

# ---------- Error monitoring (optional) ----------
# Sentry project DSN (sentry.io → Project → Settings → Client Keys). Empty:
# nothing is sent. Use a different SENTRY_ENVIRONMENT for dev and prod.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
