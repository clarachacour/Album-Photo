# Copy this file to frontend/.env for local development. On Vercel, set the
# same names in Project Settings → Environment Variables.
# These values end up in the public JavaScript: never put a secret here.

# URL of the backend API (without /api at the end)
REACT_APP_BACKEND_URL=http://localhost:8000

# Sign in with Google / Apple (optional locally)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_APPLE_CLIENT_ID=
REACT_APP_APPLE_REDIRECT_URI=
